@page "/albums/{Id:guid}"
@using DiscoTrack.ExternalIds
@inject ICatalogue Catalogue
@inject IJobQueue JobQueue
@rendermode InteractiveServer

@if (_loading)
{
	<p>Loading</p>
}
else if (_album is null)
{
	<PageTitle>Album not found</PageTitle>
	<h1>Album not found</h1>
}
else
{
	<PageTitle>@_album.Title</PageTitle>
	<h1>@_album.Artists.First().Artist.Name</h1>
	<h2>@_album.Title (@_album.Year)</h2>
	<ul>
		<li>local: @_album.Id</li>
		@foreach (var externalId in _album.ExternalIds)
		{
			<li>@externalId.Provider: @externalId.Value</li>
		}
	</ul>
	<button @onclick="SyncDiscography">Sync with discography</button>
	@if (_syncQueued)
	{
		<p>Discography sync queued</p>
	}
}

@code {
	[Parameter]
	public Guid Id { get; set; }

	private bool _loading = true;
	private Album? _album;
	private bool _syncQueued;
	private IReadOnlyList<Artist> _artists = [];
	private IReadOnlyList<ExternalId> _externalIds = [];

	protected override async Task OnInitializedAsync()
	{
		var albumId = new AlbumId(Id);
		_album = await Catalogue.GetAlbum(albumId, CancellationToken.None);
		_externalIds = _album.ExternalIds;
		_loading = false;
	}

	private async Task SyncDiscography()
	{
		await JobQueue.Enqueue(new Job(JobType.SyncAlbumWithDiscography, new AlbumId(Id)), CancellationToken.None);
		_syncQueued = true;
	}
}
