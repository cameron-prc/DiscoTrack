@page "/albums/{Id:guid}"
@using DiscoTrack.ExternalIds
@inject ICatalogue Catalogue
@inject IJobQueue JobQueue
@rendermode InteractiveServer

@if (_loading)
{
	<p>Loading</p>
}
else if (_album is null)
{
	<PageTitle>Album not found</PageTitle>
	<h1>Album not found</h1>
}
else
{
	<PageTitle>@_album.Title</PageTitle>
	<h1>@_album.Artists.First().Artist.DisplayName</h1>
	<h2>@_album.Title (@_album.Year)</h2>
	<ul>
		<li>local: @_album.Id</li>
		@foreach (var externalId in _album.ExternalIds)
		{
			<li>@externalId.Provider: @externalId.Value</li>
		}
	</ul>
	<button @onclick="SyncDiscography">Sync with discography</button>
	@if (_syncQueued)
	{
		<p>Discography sync queued</p>
	}
	<p>Track Count: @_tracks.Count</p>
	@if (MissingTracks > 0)
	{
		<p>Incomplete: @MissingTracks of @_tracks.Count tracks are not in the library</p>
	}
	<table>
		<thead>
			<tr>
				<th>Disc</th>
				<th>#</th>
				<th>Title</th>
				<th>Artists</th>
				<th>Length</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var track in _tracks)
			{
				<tr style="@(InLibrary(track) ? null : "text-decoration: line-through")">
					<td>@track.DiscNumber</td>
					<td>@track.Position</td>
					<td>@track.Title</td>
					<td>@string.Join(", ", track.Artists.Select(credit => credit.Artist.DisplayName))</td>
					<td>@Length(track)</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	[Parameter]
	public Guid Id { get; set; }

	private bool _loading = true;
	private Album? _album;
	private bool _syncQueued;
	private IReadOnlyList<Artist> _artists = [];
	private IReadOnlyList<ExternalId> _externalIds = [];
	private IReadOnlyList<Track> _tracks = [];

	protected override async Task OnInitializedAsync()
	{
		var albumId = new AlbumId(Id);
		_album = await Catalogue.GetAlbum(albumId, CancellationToken.None);
		_externalIds = _album.ExternalIds;
		_tracks = await Catalogue.GetAlbumTracks(albumId, CancellationToken.None);
		_loading = false;
	}

	private int MissingTracks
		=> _tracks.Any(InLibrary) ? _tracks.Count(track => !InLibrary(track)) : 0;

	private static bool InLibrary(Track track)
	{
		return track.ExternalIds.Any(externalId => externalId.Provider == Provider.Subsonic);
	}

	private static string Length(Track track)
	{
		return track.DurationMs is { } durationMs ? TimeSpan.FromMilliseconds(durationMs).ToString(@"m\:ss") : "";
	}

	private async Task SyncDiscography()
	{
		await JobQueue.Enqueue(new Job(JobType.SyncAlbumWithDiscography, new AlbumId(Id)), CancellationToken.None);
		_syncQueued = true;
	}
}
