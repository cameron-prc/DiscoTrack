@page "/playlists/{Id:guid}"
@inject IPlaylists PlaylistStore
@inject ICatalogue Catalogue
@inject IJobQueue JobQueue
@rendermode InteractiveServer

@if (_loading)
{
	<p>Loading</p>
}
else if (_playlist is null)
{
	<PageTitle>Playlist not found</PageTitle>
	<p>Playlist not found</p>
}
else
{
	<PageTitle>@_playlist.Name</PageTitle>

	<h1>@_playlist.Name</h1>

	<ul>
		<li>owner: @_playlist.OwnerName</li>
		<li>description: @_playlist.Description</li>
		<li>items listed by the provider: @_playlist.ItemCount</li>
		<li>songs copied: @_items.Count</li>
		<li>songs in the catalogue: @_items.Count(item => _trackAlbums.ContainsKey(item.Track.Id))</li>
		<li>tracked: @_playlist.Tracked</li>
		<li>last copied: @(_playlist.LastImportedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "never")</li>
		@if (_playlist.RemovedAt is { } removedAt)
		{
			<li>no longer listed by the provider since @removedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</li>
		}
	</ul>

	<button @onclick="SyncPlaylist">Copy now</button>

	<table>
		<thead>
			<tr>
				<th>#</th>
				<th>Track</th>
				<th>Artists</th>
				<th>Album</th>
				<th>Added</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in _items)
			{
				var albumId = _trackAlbums.TryGetValue(item.Track.Id, out var found) ? found : (AlbumId?)null;

				<tr>
					<td>@item.Position</td>
					<td>
						@if (albumId is not null)
						{
							<a href="/albums/@albumId">@item.Track.Title</a>
						}
						else
						{
							@item.Track.Title
						}
					</td>
					<td>
						@foreach (var (artist, index) in item.Track.Artists.Select((artist, index) => (artist, index)))
						{
							@(index > 0 ? ", " : "")
							@if (_artists.TryGetValue(artist.Id, out var artistId))
							{
								<a href="/artists/@artistId">@artist.Name</a>
							}
							else
							{
								@artist.Name
							}
						}
					</td>
					<td>
						@if (albumId is not null)
						{
							<a href="/albums/@albumId">@item.Track.AlbumTitle</a>
						}
						else
						{
							@item.Track.AlbumTitle
						}
					</td>
					<td>@(item.AddedAt?.ToLocalTime().ToString("dd/MM/yyyy"))</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	[Parameter]
	public Guid Id { get; set; }

	private bool _loading = true;
	private Playlist? _playlist;
	private IReadOnlyList<PlaylistItem> _items = [];
	private IReadOnlyDictionary<ExternalId, AlbumId> _trackAlbums = new Dictionary<ExternalId, AlbumId>();
	private IReadOnlyDictionary<ExternalId, ArtistId> _artists = new Dictionary<ExternalId, ArtistId>();

	// An item is linked when the catalogue holds a track or artist carrying the provider's id for it
	protected override async Task OnParametersSetAsync()
	{
		var playlistId = new PlaylistId(Id);

		_playlist = await PlaylistStore.GetPlaylist(playlistId, CancellationToken.None);
		_items = _playlist is null ? [] : await PlaylistStore.GetItems(playlistId, CancellationToken.None);
		_trackAlbums = await Catalogue.FindTrackAlbums(_items.Select(item => item.Track.Id).ToList(), CancellationToken.None);
		_artists = await Catalogue.FindArtists(_items.SelectMany(item => item.Track.Artists).Select(artist => artist.Id).ToList(), CancellationToken.None);
		_loading = false;
	}

	private async Task SyncPlaylist()
	{
		await JobQueue.Enqueue(new Job(JobType.SyncPlaylist, _playlist!.Id), CancellationToken.None);
	}
}
